@@meta
id: sgk-save
anchor:
order: 2.5
title: Сейв при прокрутці (м'яч летить - рукавиця ловить)
pos: між блоком 02 (Чому Synergy) і блоком 03 (Каталог).
glove: yes
extra: netColor=rgba(255,255,255,0.06)|колір сітки воріт на фоні; gloveBody=#F4F6F1|колір рукавиці; gloveDark=#0A0C0B|контур і манжета рукавиці; ballColor=#F4F6F1|колір м'яча; ballDark=#0A0C0B|візерунок м'яча; finalWord=rgba(255,255,255,0.06)|величезне контурне слово на фоні

@@install
Як працює: блок займає кілька екранів у висоту. Поки відвідувач
гортає, картинка "прилипає" до екрану, а м'яч летить у ворота і
рукавиця його ловить. Далі сторінка гортається як звичайно.
Висоту (а значить і швидкість сцени) задає settings.scrollLength.

@@html
<section id="sgk-save" aria-label="Сейв">
  <div class="sgk-stage">
    <div class="sgk-bgnet"></div>
    <div class="sgk-bigword" data-sgk="bigWord"></div>
    <div class="sgk-floor"></div>
    <div class="sgk-lines" data-sgk="lines"></div>
    <div class="sgk-speed"><b data-sgk="speed">0</b><span data-sgk="speedUnit"></span></div>
    <div class="sgk-trail" data-sgk="trail"></div>
    <div class="sgk-glove" data-sgk="glove"></div>
    <div class="sgk-ball" data-sgk="ball"></div>
    <div class="sgk-flash" data-sgk="flash"></div>
    <div class="sgk-final" data-sgk="final">
      <div class="sgk-final-t" data-sgk="finalTitle"></div>
      <p class="sgk-final-d" data-sgk="finalText"></p>
    </div>
    <div class="sgk-hint" data-sgk="hint"><span></span></div>
  </div>
</section>

@@css
#sgk-save{padding:0;overflow:visible;height:var(--sgk-len,260vh)}
#sgk-save.sgk-static{height:auto}
#sgk-save .sgk-stage{position:-webkit-sticky;position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;background:radial-gradient(120% 90% at 70% 40%,rgba(200,255,46,.07) 0%,rgba(0,0,0,0) 55%),var(--sgk-bg)}
#sgk-save.sgk-static .sgk-stage{position:relative}
#sgk-save .sgk-bgnet{position:absolute;top:0;right:0;bottom:0;left:0;
  background-image:repeating-linear-gradient(45deg,var(--sgk-netColor) 0 1px,rgba(0,0,0,0) 1px 38px),repeating-linear-gradient(-45deg,var(--sgk-netColor) 0 1px,rgba(0,0,0,0) 1px 38px);
  -webkit-mask-image:radial-gradient(80% 80% at 70% 45%,#000 0%,rgba(0,0,0,0) 75%);mask-image:radial-gradient(80% 80% at 70% 45%,#000 0%,rgba(0,0,0,0) 75%)}
#sgk-save .sgk-bigword{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);text-align:center;font-family:var(--sgk-font-h);font-weight:800;font-size:28vw;line-height:1;color:transparent;-webkit-text-stroke:1.5px var(--sgk-finalWord);white-space:nowrap;pointer-events:none}
#sgk-save .sgk-floor{position:absolute;left:-10%;right:-10%;bottom:-30%;height:60%;background:radial-gradient(50% 50% at 50% 50%,rgba(200,255,46,.10),rgba(0,0,0,0) 70%)}
#sgk-save .sgk-lines{position:absolute;left:clamp(16px,6vw,96px);top:50%;transform:translateY(-50%);width:min(520px,46vw);z-index:4}
#sgk-save .sgk-line{position:absolute;left:0;top:0;width:100%;transform:translateY(-50%);font-family:var(--sgk-font-h);font-weight:800;font-size:clamp(26px,3.6vw,52px);line-height:1.08;letter-spacing:-.02em;color:var(--sgk-text);opacity:0;will-change:opacity,transform}
#sgk-save .sgk-line em{font-style:normal;color:var(--sgk-accent);white-space:nowrap}
#sgk-save .sgk-speed{position:absolute;left:clamp(16px,6vw,96px);bottom:clamp(28px,8vh,72px);z-index:4;display:flex;align-items:baseline;gap:8px;color:var(--sgk-textMuted);font-size:14px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
#sgk-save .sgk-speed b{font-family:var(--sgk-font-h);font-weight:800;font-size:clamp(34px,4vw,56px);letter-spacing:0;color:var(--sgk-accent);min-width:2.6ch;font-variant-numeric:tabular-nums}
#sgk-save .sgk-ball,#sgk-save .sgk-glove,#sgk-save .sgk-flash,#sgk-save .sgk-trail{position:absolute;left:0;top:0;will-change:transform}
#sgk-save .sgk-ball{z-index:6;width:var(--bs,90px);height:var(--bs,90px);margin:calc(var(--bs,90px) / -2) 0 0 calc(var(--bs,90px) / -2);filter:drop-shadow(0 18px 30px rgba(0,0,0,.5))}
#sgk-save .sgk-ball svg{width:100%;height:100%}
#sgk-save .sgk-glove{z-index:5;width:var(--gw,240px);height:calc(var(--gw,240px) * 1.25);margin:calc(var(--gw,240px) * -0.7) 0 0 calc(var(--gw,240px) * -0.5);filter:drop-shadow(0 30px 50px rgba(0,0,0,.55))}
#sgk-save .sgk-glove img{width:100%;height:100%;display:block}
#sgk-save .sgk-trail{z-index:4;width:var(--tl,260px);height:6px;margin:-3px 0 0 0;border-radius:6px;transform-origin:0 50%;background:linear-gradient(90deg,rgba(200,255,46,0),var(--sgk-accent));opacity:0}
#sgk-save .sgk-flash{z-index:7;width:340px;height:340px;margin:-170px 0 0 -170px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.9) 0%,var(--sgk-accent) 18%,rgba(200,255,46,.25) 42%,rgba(200,255,46,0) 70%);opacity:0;mix-blend-mode:screen;pointer-events:none}
#sgk-save .sgk-final{position:absolute;left:clamp(16px,6vw,96px);top:50%;z-index:8;width:min(560px,48vw);transform:translateY(-50%);opacity:0}
#sgk-save .sgk-final-t{font-family:var(--sgk-font-h);font-weight:800;font-size:clamp(40px,6.4vw,96px);line-height:.98;letter-spacing:-.03em;color:var(--sgk-text)}
#sgk-save .sgk-final-t em{font-style:normal;color:var(--sgk-accent)}
#sgk-save .sgk-final-d{margin-top:18px;font-size:clamp(15px,1.3vw,18px);line-height:1.6;color:var(--sgk-textMuted);opacity:0}
#sgk-save .sgk-hint{position:absolute;left:50%;bottom:22px;z-index:9;width:26px;height:40px;margin-left:-13px;border:1.5px solid var(--sgk-ghostBorder);border-radius:14px;transition:opacity .4s ease}
#sgk-save .sgk-hint span{position:absolute;left:50%;top:7px;width:3px;height:8px;margin-left:-1.5px;border-radius:3px;background:var(--sgk-accent);animation:sgkHint 1.6s ease-in-out infinite}
@keyframes sgkHint{0%{transform:translateY(0);opacity:1}70%{transform:translateY(13px);opacity:0}100%{opacity:0}}
@media (max-width:700px){
  #sgk-save .sgk-lines,#sgk-save .sgk-final{left:16px;right:16px;width:auto;top:20%;transform:none}
  #sgk-save .sgk-line{transform:none;font-size:clamp(24px,7.4vw,34px)}
  #sgk-save .sgk-final{top:16%}
  #sgk-save .sgk-final-t{font-size:clamp(40px,12vw,58px)}
  #sgk-save .sgk-speed{left:16px;bottom:24px}
  #sgk-save .sgk-bigword{font-size:40vw;top:62%}
}

@@config
    lines: [                                            /* ЗМІНИТИ - фрази, що змінюють одна одну під час польоту м'яча. [слово] = акцент */
      "М'яч летить [120 км/год]",
      "У воротаря - [менше пів секунди]",
      "І все вирішує [хват]"
    ],
    finalTitle: "Synergy [тримає].",                    /* ЗМІНИТИ - фінальний напис після сейву */
    finalText: "Рукавиці, в яких не страшно у вирішальний момент.", /* ЗМІНИТИ - текст під фінальним написом */
    bigWord: "SAVE",                                    /* ЗМІНИТИ - величезне контурне слово на фоні ("" - прибрати) */
    speedMax: 120,                                      /* ЗМІНИТИ - до якої цифри розганяється лічильник швидкості */
    speedUnit: "км/год",                                /* ЗМІНИТИ - підпис лічильника */

@@settings
      scrollLength: 260,  /* ЗМІНИТИ - висота блоку у % висоти екрану (більше = сцена повільніша). 200-350 */
      showHint: true      /* ЗМІНИТИ - показувати "мишку" з підказкою гортати */

@@js
  var lens = Math.max(150, S.scrollLength || 260);
  root.style.setProperty("--sgk-len", lens + "vh");
  var linesEl = q("lines"), lineEls = [];
  CONFIG.lines.forEach(function (t) { var d = mk("div", "sgk-line"); rich(d, t); linesEl.appendChild(d); lineEls.push(d); });
  rich(q("finalTitle"), CONFIG.finalTitle);
  txt("finalText", CONFIG.finalText);
  txt("bigWord", CONFIG.bigWord);
  txt("speedUnit", CONFIG.speedUnit);
  if (!S.showHint) q("hint").style.display = "none";

  var gl = mk("img"); gl.alt = ""; gl.src = svgUrl(gloveSvg({ body: CONFIG.colors.gloveBody, accent: CONFIG.colors.accent, dark: CONFIG.colors.gloveDark }));
  q("glove").appendChild(gl);
  var bc = CONFIG.colors.ballColor, bd = CONFIG.colors.ballDark;
  q("ball").innerHTML = '<svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="47" fill="' + bc + '" stroke="' + bd + '" stroke-width="3"/>' +
    '<path d="M50 31 L64 41 L59 57 L41 57 L36 41 Z" fill="' + bd + '"/>' +
    '<path d="M50 31 L50 6 M64 41 L87 33 M59 57 L74 79 M41 57 L26 79 M36 41 L13 33" stroke="' + bd + '" stroke-width="3" fill="none"/>' +
    '<path d="M38 5 L50 6 L62 5 L56 0 L44 0 Z M88 22 L87 33 L95 44 L99 34 Z M74 79 L86 76 L80 92 L70 94 Z M26 79 L30 94 L20 92 L14 76 Z M13 33 L5 44 L1 34 L12 22 Z" fill="' + bd + '"/></svg>';

  var ball = q("ball"), glove = q("glove"), flash = q("flash"), trail = q("trail"), speed = q("speed"), fin = q("final"), finD = q("finalText"), hint = q("hint");
  function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }
  function seg(p, a, b) { return clamp((p - a) / (b - a), 0, 1); }
  function ease(t) { return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2; }
  function eOut(t) { return 1 - Math.pow(1 - t, 3); }
  function bez(a, b, c, t) { var u = 1 - t; return u * u * a + 2 * u * t * b + t * t * c; }
  var W = 0, H = 0, mob = false;
  function measure() {
    var st = root.querySelector(".sgk-stage"); W = st.clientWidth; H = st.clientHeight; mob = W < 700;
    var m = Math.min(W, H);
    root.style.setProperty("--bs", Math.round(m * (mob ? 0.16 : 0.12)) + "px");
    root.style.setProperty("--gw", Math.round(m * (mob ? 0.42 : 0.34)) + "px");
    root.style.setProperty("--tl", Math.round(W * 0.22) + "px");
  }
  var CATCH = 0.62;
  function render(p) {
    var cx = W * (mob ? 0.6 : 0.68), cy = H * (mob ? 0.66 : 0.46);
    var sx = -W * 0.06, sy = H * 0.9, kx = W * (mob ? 0.2 : 0.32), ky = H * (mob ? 0.2 : 0.02);
    /* рукавиця */
    var g = ease(seg(p, 0.32, CATCH));
    var gx = W * 1.2 + (cx - W * 1.2) * g, gy = H * 0.78 + (cy - H * 0.78) * g;
    var sq = Math.sin(seg(p, CATCH, CATCH + 0.08) * Math.PI);
    var grot = 24 * (1 - g) - 6 - sq * 4;
    glove.style.transform = "translate3d(" + gx.toFixed(1) + "px," + gy.toFixed(1) + "px,0) rotate(" + grot.toFixed(1) + "deg) scale(" + (1 - sq * 0.08).toFixed(3) + ")";
    /* м'яч */
    var t = seg(p, 0.04, CATCH), bx, by, bs, br;
    if (p < CATCH) {
      bx = bez(sx, kx, cx, t); by = bez(sy, ky, cy, t); bs = 0.35 + 0.65 * t; br = t * 900;
      var dx = 2 * (1 - t) * (kx - sx) + 2 * t * (cx - kx), dy = 2 * (1 - t) * (ky - sy) + 2 * t * (cy - ky);
      var ang = Math.atan2(dy, dx) * 180 / Math.PI;
      trail.style.transform = "translate3d(" + bx.toFixed(1) + "px," + by.toFixed(1) + "px,0) rotate(" + (ang + 180).toFixed(1) + "deg)";
      trail.style.opacity = (t > 0.02 && t < 0.98) ? (0.25 + 0.5 * t).toFixed(2) : "0";
    } else {
      bx = gx - W * 0.004; by = gy - (mob ? 6 : 10); bs = 1 - sq * 0.06; br = 900 + sq * 20;
      trail.style.opacity = "0";
    }
    ball.style.transform = "translate3d(" + bx.toFixed(1) + "px," + by.toFixed(1) + "px,0) rotate(" + br.toFixed(0) + "deg) scale(" + bs.toFixed(3) + ")";
    ball.style.opacity = p < 0.03 ? "0" : "1";
    /* спалах */
    var f = seg(p, CATCH - 0.01, CATCH + 0.12);
    flash.style.transform = "translate3d(" + cx.toFixed(1) + "px," + cy.toFixed(1) + "px,0) scale(" + (0.4 + f * 1.6).toFixed(3) + ")";
    flash.style.opacity = (Math.sin(f * Math.PI) * 0.9).toFixed(3);
    /* швидкість */
    var sp = p < CATCH ? Math.round(CONFIG.speedMax * ease(seg(p, 0.04, 0.55))) : Math.round(CONFIG.speedMax * (1 - seg(p, CATCH, CATCH + 0.06)));
    speed.textContent = String(sp);
    /* фрази */
    var n = lineEls.length || 1, span = (CATCH - 0.02) / n;
    lineEls.forEach(function (el, i) {
      var a = i * span, b = a + span;
      var o = seg(p, a, a + span * 0.25) * (1 - seg(p, b - span * 0.2, b));
      if (i === 0) o = 1 - seg(p, b - span * 0.2, b);
      el.style.opacity = o.toFixed(3);
      el.style.transform = (mob ? "" : "translateY(-50%) ") + "translateY(" + ((1 - o) * (p > b - span * 0.2 ? -18 : 18)).toFixed(1) + "px)";
    });
    /* фінал */
    var fo = eOut(seg(p, CATCH + 0.06, CATCH + 0.18));
    fin.style.opacity = fo.toFixed(3);
    fin.style.transform = (mob ? "" : "translateY(-50%) ") + "translateY(" + ((1 - fo) * 24).toFixed(1) + "px)";
    finD.style.opacity = seg(p, CATCH + 0.14, CATCH + 0.26).toFixed(3);
    q("speed").parentNode.style.opacity = (1 - seg(p, CATCH + 0.1, CATCH + 0.18)).toFixed(3);
    hint.style.opacity = p > 0.06 ? "0" : "1";
  }

  measure();
  if (!animOn) {
    root.classList.add("sgk-static");
    hint.style.display = "none";
    setTimeout(function () { measure(); render(1); }, 0);
  } else {
    var ticking = false, visible = true;
    function progress() {
      var r = root.getBoundingClientRect(), vh = window.innerHeight || H;
      return clamp(-r.top / Math.max(1, r.height - vh), 0, 1);
    }
    function tick() { ticking = false; render(progress()); }
    function onScroll() { if (!visible || ticking) return; ticking = true; requestAnimationFrame(tick); }
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", function () { measure(); render(progress()); });
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) { es.forEach(function (e) { visible = e.isIntersecting; if (visible) onScroll(); }); }, { rootMargin: "100px 0px" }).observe(root);
    }
    render(progress());
  }

@@notes
ЩО ВІДБУВАЄТЬСЯ
  Відвідувач гортає сторінку - екран "прилипає", м'яч летить по дузі
  з лаймовим слідом, лічильник швидкості розганяється до 120, фрази
  змінюють одна одну. Рукавиця виїжджає справа і ловить м'яч:
  спалах, рукавиця стискається, лічильник падає до 0, з'являється
  фінальний напис. Далі сторінка гортається як звичайно.
  На телефоні працює так само (свайпом).

ТЕКСТИ
  lines      - фрази під час польоту (2-4 штуки), [слово] = акцент;
  finalTitle - напис після сейву; finalText - текст під ним;
  bigWord    - величезне контурне слово на фоні;
  speedMax, speedUnit - лічильник швидкості.

КОЛЬОРИ РУКАВИЦІ І М'ЯЧА
  gloveBody - колір рукавиці, gloveDark - контур і манжета,
  accent - смужки на пальцях, логотип і слід м'яча;
  ballColor / ballDark - м'яч.

settings.scrollLength - наскільки довго триває сцена (у % висоти
  екрану). 260 - оптимально; 200 - швидше; 350 - повільніше.

Якщо settings.animations: false - показується одразу фінальна
картинка (рукавиця з м'ячем) без прокрутки.
