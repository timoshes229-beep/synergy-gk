@@meta
id: sgk-game
anchor: game
title: В грі (галерея та відгуки)
pos: після блоку 06 (Засновник).
icons: yes
colors: bg=#0F1211

@@html
<section id="sgk-game" aria-label="В грі">
  <div class="sgk-wrap">
    <div class="sgk-top">
      <div class="sgk-head">
        <div class="sgk-kicker sgk-rv" data-sgk="kicker"></div>
        <h2 class="sgk-h2 sgk-rv" data-d="0.08" data-sgk="title"></h2>
      </div>
      <a class="sgk-btn sgk-btn--ghost sgk-rv" data-d="0.16" data-sgk="insta" href="#"><span class="sgk-bi" data-sgk="instaIc"></span><span data-sgk="instaText"></span></a>
    </div>
    <div class="sgk-gal" data-sgk="gallery"></div>

    <div class="sgk-rev-top">
      <div class="sgk-rev-title sgk-rv" data-sgk="revTitle"></div>
      <div class="sgk-arrows sgk-rv">
        <button class="sgk-arr" type="button" data-sgk="prev" aria-label="prev"></button>
        <button class="sgk-arr" type="button" data-sgk="next" aria-label="next"></button>
      </div>
    </div>
    <div class="sgk-track sgk-rv" data-d="0.1" data-sgk="reviews"></div>
  </div>
</section>

@@css
#sgk-game .sgk-top{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:clamp(28px,4vw,48px)}
#sgk-game .sgk-top .sgk-head{margin-bottom:0}
#sgk-game .sgk-bi{display:flex}
#sgk-game .sgk-bi svg{width:20px;height:20px}
#sgk-game .sgk-gal{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:clamp(150px,17vw,250px);gap:14px}
#sgk-game .sgk-tile{position:relative;display:block;border-radius:22px;overflow:hidden;background:var(--sgk-phBg)}
#sgk-game .sgk-tile:first-child{grid-column:span 2;grid-row:span 2}
#sgk-game .sgk-tile .sgk-img,#sgk-game .sgk-tile .sgk-ph{transition:transform 1s cubic-bezier(.2,.8,.2,1)}
#sgk-game .sgk-tile:hover .sgk-img,#sgk-game .sgk-tile:hover .sgk-ph{transform:scale(1.07)}
#sgk-game .sgk-tile::after{content:"";position:absolute;left:0;right:0;bottom:0;height:60%;background:linear-gradient(0deg,rgba(0,0,0,.65),rgba(0,0,0,0));opacity:0;transition:opacity .45s ease;pointer-events:none}
#sgk-game .sgk-tile:hover::after{opacity:1}
#sgk-game .sgk-cap{position:absolute;left:18px;right:18px;bottom:16px;z-index:2;font-size:14px;font-weight:700;color:#fff;opacity:0;transform:translateY(12px);transition:opacity .45s ease,transform .45s ease}
#sgk-game .sgk-tile:hover .sgk-cap{opacity:1;transform:none}
#sgk-game .sgk-rev-top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:clamp(56px,7vw,96px);margin-bottom:22px}
#sgk-game .sgk-rev-title{font-family:var(--sgk-font-h);font-weight:700;font-size:clamp(20px,2vw,28px);color:var(--sgk-text)}
#sgk-game .sgk-arrows{display:flex;gap:10px}
#sgk-game .sgk-arr{width:50px;height:50px;border-radius:50%;border:1px solid var(--sgk-cardBorder) !important;display:flex;align-items:center;justify-content:center;color:var(--sgk-text);transition:background .25s ease,color .25s ease,transform .25s ease}
#sgk-game .sgk-arr svg{width:20px;height:20px}
#sgk-game .sgk-arr[data-sgk="prev"] svg{transform:rotate(180deg)}
#sgk-game .sgk-arr:hover{background:var(--sgk-accent);color:var(--sgk-btnText);transform:scale(1.06)}
#sgk-game .sgk-track{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;padding-bottom:4px;cursor:grab}
#sgk-game .sgk-track::-webkit-scrollbar{display:none}
#sgk-game .sgk-track.is-drag{cursor:grabbing;scroll-snap-type:none;scroll-behavior:auto}
#sgk-game .sgk-rev{flex:0 0 calc((100% - 32px) / 3);scroll-snap-align:start;display:flex;flex-direction:column;padding:26px;border-radius:24px;background:var(--sgk-cardBg);border:1px solid var(--sgk-cardBorder);transition:border-color .35s ease,transform .35s ease;user-select:none}
#sgk-game .sgk-rev:hover{border-color:var(--sgk-accentSoft);transform:translateY(-4px)}
#sgk-game .sgk-stars{display:flex;gap:4px;color:var(--sgk-accent)}
#sgk-game .sgk-stars svg{width:18px;height:18px;fill:currentColor}
#sgk-game .sgk-rev-t{margin-top:16px;margin-bottom:22px;font-size:15px;line-height:1.65;color:var(--sgk-text)}
#sgk-game .sgk-who{display:flex;align-items:center;gap:12px;margin-top:auto}
#sgk-game .sgk-ava{position:relative;flex:none;width:46px;height:46px;border-radius:50%;overflow:hidden;display:flex;align-items:center;justify-content:center;background:var(--sgk-accent);color:var(--sgk-btnText);font-family:var(--sgk-font-h);font-weight:800;font-size:16px}
#sgk-game .sgk-ava img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover}
#sgk-game .sgk-nm{font-weight:800;font-size:15px;color:var(--sgk-text)}
#sgk-game .sgk-rl{font-size:13px;color:var(--sgk-textMuted)}
@media (max-width:1000px){
  #sgk-game .sgk-rev{flex-basis:calc((100% - 16px) / 2)}
}
@media (max-width:700px){
  #sgk-game .sgk-gal{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:clamp(140px,42vw,220px);gap:10px}
  #sgk-game .sgk-tile{border-radius:18px}
  #sgk-game .sgk-cap{opacity:1;transform:none;font-size:12.5px;left:12px;bottom:10px}
  #sgk-game .sgk-tile::after{opacity:1}
  #sgk-game .sgk-rev{flex-basis:86%}
  #sgk-game .sgk-track{margin:0 -16px;padding:0 16px 4px;width:calc(100% + 32px);scroll-padding:0 16px}
  #sgk-game .sgk-top .sgk-btn{width:100%}
}

@@config
    kicker: "В грі",                                      /* ЗМІНИТИ - надпис над заголовком */
    title: "Рукавиці Synergy [на полі]",                  /* ЗМІНИТИ - заголовок, [слово] = акцент */
    instagramText: "Більше в @synergy.gk",                /* ЗМІНИТИ - текст кнопки */
    instagramLink: "https://www.instagram.com/synergy.gk/", /* ЗМІНИТИ - посилання ("" - сховати кнопку) */
    photoLabel: "Фото з гри",                             /* ЗМІНИТИ - підпис на заглушках */

    gallery: [                                            /* ЗМІНИТИ - фото галереї. Перше - велике. Ідеально 5 штук */
      { image: "__ASSETS__hero-desktop.jpg", caption: "Засновник Synergy на тренуванні", link: "" }, /* ЗМІНИТИ - link: "" = без посилання */
      { image: "", caption: "Сейв у матчі",          link: "" },
      { image: "", caption: "Розминка перед грою",   link: "" },
      { image: "", caption: "Рукавиці крупним планом", link: "" },
      { image: "", caption: "Команда воротарів",     link: "" }
    ],

    reviewsTitle: "Відгуки воротарів",                    /* ЗМІНИТИ - заголовок відгуків */
    reviews: [                                            /* ЗМІНИТИ - відгуки (ЗАГЛУШКИ - замініть реальними з Instagram) */
      { stars: 5, text: "Тут буде реальний відгук воротаря про рукавиці: хват, посадка, скільки служать.", name: "Ім'я воротаря", role: "Команда / вік", photo: "" },
      { stars: 5, text: "Тут буде реальний відгук. Попросіть у клієнта 3-6 відгуків або скріншотів з Instagram.", name: "Ім'я воротаря", role: "Команда / вік", photo: "" },
      { stars: 5, text: "Тут буде реальний відгук. Можна додати фото людини в полі photo.", name: "Ім'я воротаря", role: "Команда / вік", photo: "" },
      { stars: 5, text: "Тут буде реальний відгук. Відгуків може бути скільки завгодно - вони гортаються.", name: "Ім'я воротаря", role: "Команда / вік", photo: "" }
    ],

@@js
  rich(q("kicker"), CONFIG.kicker);
  rich(q("title"), CONFIG.title);
  txt("instaText", CONFIG.instagramText);
  q("instaIc").innerHTML = icon("instagram");
  if (CONFIG.instagramLink) lnk(q("insta"), CONFIG.instagramLink, true); else q("insta").style.display = "none";

  var gal = q("gallery");
  CONFIG.gallery.forEach(function (g, i) {
    var t = mk(g.link ? "a" : "div", "sgk-tile sgk-rv");
    if (g.link) lnk(t, g.link, /^https?:/.test(g.link));
    t.setAttribute("data-d", (0.05 + i * 0.08).toFixed(2));
    t.appendChild(media(g.image, g.caption, CONFIG.photoLabel, "photo"));
    if (g.caption) t.appendChild(mk("div", "sgk-cap", g.caption));
    gal.appendChild(t);
  });

  txt("revTitle", CONFIG.reviewsTitle);
  var track = q("reviews");
  var STAR = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/></svg>';
  CONFIG.reviews.forEach(function (r) {
    var c = mk("div", "sgk-rev");
    var st = mk("div", "sgk-stars"); var html = ""; for (var k = 0; k < (r.stars || 5); k++) html += STAR; st.innerHTML = html; c.appendChild(st);
    c.appendChild(mk("p", "sgk-rev-t", r.text));
    var w = mk("div", "sgk-who");
    var av = mk("div", "sgk-ava", (r.name || "?").trim().charAt(0).toUpperCase());
    if (r.photo) { var im = mk("img"); im.src = r.photo; im.alt = r.name; av.appendChild(im); }
    w.appendChild(av);
    var nb = mk("div"); nb.appendChild(mk("div", "sgk-nm", r.name)); nb.appendChild(mk("div", "sgk-rl", r.role)); w.appendChild(nb);
    c.appendChild(w);
    track.appendChild(c);
  });

  q("prev").innerHTML = icon("arrow", 2); q("next").innerHTML = icon("arrow", 2);
  function stepW() { var c = track.querySelector(".sgk-rev"); return c ? c.getBoundingClientRect().width + 16 : 300; }
  q("prev").addEventListener("click", function () { track.scrollBy({ left: -stepW(), behavior: "smooth" }); });
  q("next").addEventListener("click", function () {
    if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 4) track.scrollTo({ left: 0, behavior: "smooth" });
    else track.scrollBy({ left: stepW(), behavior: "smooth" });
  });

  /* перетягування мишкою на ПК */
  if (fine) {
    var down = false, sx = 0, sl = 0, moved = false;
    track.addEventListener("mousedown", function (e) { down = true; moved = false; sx = e.pageX; sl = track.scrollLeft; track.classList.add("is-drag"); });
    window.addEventListener("mouseup", function () { if (!down) return; down = false; track.classList.remove("is-drag"); });
    track.addEventListener("mousemove", function (e) { if (!down) return; var dx = e.pageX - sx; if (Math.abs(dx) > 4) moved = true; track.scrollLeft = sl - dx; });
    track.addEventListener("click", function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
  }

  reveal();

@@notes
kicker / title - надпис і заголовок.
instagramText / instagramLink - кнопка на Instagram праворуч.

ГАЛЕРЕЯ  ->  gallery
  Перше фото - велике (2x2), інші - маленькі. Найкраще 5 фото.
  image   - фото ("" = заглушка);
  caption - підпис, з'являється при наведенні (на телефоні видно завжди);
  link    - посилання при кліку (наприклад, пост в Instagram), "" - без.

ВІДГУКИ  ->  reviews
  stars - кількість зірок (1-5); text - текст; name - ім'я;
  role  - команда/вік; photo - фото людини ("" = перша літера імені).
  Відгуки гортаються стрілками, свайпом на телефоні і перетягуванням
  мишкою на ПК.

УВАГА: відгуки - ЗАГЛУШКИ. Не публікуйте сайт з вигаданими
відгуками - попросіть у клієнта реальні (скріншоти з Instagram теж
підійдуть).
